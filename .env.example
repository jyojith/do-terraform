# Copy to .env in the repo root and fill in. Do not commit .env.
# Load with: set -a && source .env && set +a

# V2 *personal* API token (dop_v1_...), read+write, same DO account as the domain’s DNS.
# Not: Spaces (S3) access keys, not AWS_ keys for state — those 401 the Domains API.
TF_VAR_do_token=
# Quote bcrypt hashes because they contain `$` and are sourced by the shell.
TF_VAR_argocd_admin_password_hash=''
TF_VAR_traefik_dashboard_password_hash=''

# DigitalOcean Gradient AI model access key (Gradient AI dashboard → model access keys). The argocd
# stack builds the bizquery-secrets Secret from this (chat + embeddings); other app secrets (DB pw,
# session, bootstrap, admin) are auto-generated. Note: lowercase var name, case-sensitive.
TF_VAR_do_model_access_key=

# GHCR image pull (the argocd stack creates the ghcr-pull docker-registry Secret from these so the
# cluster can pull the private bizquery image). PAT needs read:packages.
TF_VAR_ghcr_username=
TF_VAR_ghcr_pat=

# Argo CD repository credential for the PRIVATE deployment repo (so Argo CD can read its manifests).
# A GitHub PAT with contents:read on bizquery-platform-deployment. Can be the SAME fine-grained PAT
# you use for the CI bump (DEPLOY_REPO_TOKEN) if you give that one contents:read+write.
TF_VAR_deploy_repo_pat=

# Optional: Terraform / Terragrunt also accept DO_TOKEN if TF_VAR_do_token is unset
# DO_TOKEN=
#
# Optional: use the same token as GitHub Actions (repository secret DO_TOKEN) without pasting it here:
#   gh auth login
#   leave TF_VAR_do_token empty, then ./scripts/tg.sh will run `gh secret get DO_TOKEN`, or:
#   export TG_DO_TOKEN_FROM_GITHUB=1   # forces GitHub secret even if .env has a stale token

# Optional: remote state in S3-compatible storage (e.g. DO Spaces). If bucket, endpoint, and both
# AWS keys are set, Terragrunt uses the S3 backend; otherwise it uses local terraform.tfstate per
# stack (enough for fmt/validate CI without Spaces).
# TG_STATE_BUCKET=bizquery-tf
# TG_STATE_REGION=fra1
# S3 *API* base for the region (not the bucket vhost). Correct:
#   https://fra1.digitaloceanspaces.com
# Same bucket, wrong value for this field (browser / object URL style):
#   https://bizquery-tf.fra1.digitaloceanspaces.com
# TG_STATE_ENDPOINT=https://fra1.digitaloceanspaces.com
# S3 backend signing region (AWS region name; for DO Spaces use us-east-1 unless you know better)
# TG_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
